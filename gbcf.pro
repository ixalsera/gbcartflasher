HEADERS += src/assets/about.xpm \
           src/assets/flasher.xpm \
           src/assets/icon.xpm
SOURCES += src/EraseThread.cpp \
           src/gbcflsh.cpp \
           src/Logic.cpp \
           src/ReadFlashThread.cpp \
           src/ReadRamThread.cpp \
           src/Settings.cpp \
           src/WriteFlashThread.cpp \
           src/WriteRamThread.cpp
# Views
SOURCES += src/views/About.cpp \
           src/views/Gui.cpp
TRANSLATIONS += src/translations/gbcflsh_english.ts \
                src/translations/gbcflsh_french.ts \
                src/translations/gbcflsh_german.ts \
                src/translations/gbcflsh_polish.ts
RC_FILE = src/res.rc
win32 {
